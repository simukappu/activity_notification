#!/usr/bin/env ruby
# frozen_string_literal: true

# Binstub for the vite_ruby CLI (bin/vite build, bin/vite dev, ...).
# The sample application uses the Gemfile in the gem root directory.
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../../../../Gemfile", __FILE__)

require "rubygems"
require "bundler/setup"

load Gem.bin_path("vite_ruby", "vite")
